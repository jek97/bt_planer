<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Repeat indefinitely until any node returns FAILURE -->
    <Repeat num_cycles="-1">
      <Sequence>
        <MoveCommand command="straight"/>
        <MoveCommand command="turn_right"/>
        <MoveCommand command="straight"/>
        <MoveCommand command="turn_left"/>
        <MoveCommand command="straight"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
